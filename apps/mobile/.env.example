# Copy to `.env` and set the LAN address of the machine running the MusicCheck API
# (services/api, port 8000). The phone and that machine must be on the same Wi-Fi.
#   - Physical phone (Expo Go / dev build): http://<computer LAN IP>:8000  e.g. http://192.168.1.23:8000
#   - Android emulator:                     http://10.0.2.2:8000
#   - iOS simulator (same Mac):             http://localhost:8000
# `localhost` does NOT work from a physical phone. This value is inlined into the JS bundle:
# never put secrets in EXPO_PUBLIC_* variables. Restart `npx expo start` after changing it.
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.y:8000
