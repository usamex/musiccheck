{
  "name": "musiccheck-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "doctor": "npx --yes expo-doctor",
    "export:check": "expo export --platform android --output-dir /tmp/musiccheck-export/android --clear && expo export --platform ios --output-dir /tmp/musiccheck-export/ios",
    "contract:check": "tsc --ignoreConfig src/api/client.ts --outDir /tmp/musiccheck-contract --rootDir src --module nodenext --moduleResolution nodenext --target es2022 --esModuleInterop --skipLibCheck --types node && node scripts/contract-check.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.tsx"
    ]
  }
}
