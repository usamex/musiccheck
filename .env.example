# Copy to .env (git-ignored) and adjust. Read by compose.yaml and by the API (MUSICCHECK_*).

# Required for catalog writes (POST/DELETE /v1/catalog/tracks). Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MUSICCHECK_CATALOG_ADMIN_TOKEN=

# Recognition provider. Only "none" exists until the M0 model feasibility gate passes.
MUSICCHECK_RECOGNITION_PROVIDER=none

# Postgres password used by compose.yaml (dev only).
POSTGRES_PASSWORD=musiccheck-dev

# Host ports (compose.yaml). The DB binds to 127.0.0.1 only.
MUSICCHECK_API_PORT=8000
MUSICCHECK_DB_PORT=5433

# Local (non-Docker) runs default to SQLite at ./data/musiccheck.db. To use the compose DB instead:
# MUSICCHECK_DATABASE_URL=postgresql+psycopg://musiccheck:musiccheck-dev@127.0.0.1:5433/musiccheck
